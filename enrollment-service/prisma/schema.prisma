generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Enrollment {
  id            Int      @id @default(autoincrement())
  studentId     Int
  courseId      Int
  amount        Float
  status        String   @default("PENDING")
  transactionId String   @unique
  createdAt     DateTime @default(now())
}
